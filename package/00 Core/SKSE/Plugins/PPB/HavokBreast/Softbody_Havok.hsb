# PPB copy (2026-09-27): identical to HavokWig's Softbody_Havok.hsb except the fsmp lines point at PPB's own kinematic XML
# HavokWig softbody data v2 (0.4.0 'our own Havok breast') - generated by convert_softbody_v2.py (format at the top of that script)
# sources: softbodyFix.xml md5 c56ac47ce3988bf8ba342e13ab3bd40e | skeleton_female.nif (PPB) md5 e5c597edccebcf795a64f6544ff16a3b | femalebody_1 md5 9812ae2c944ce6f290f41601c732f972 | femalebody_0 md5 c6525f775b140c7f9d2dd7a935f9bc0f
# placement rule: breastfit.py (the DLL's BreastFit.cpp is the same algorithm); rotation convention: v_parent = M * v_child
softbody Softbody_Havok
version 2
param friction 0.000
param restitution 0.200
# breastVsBreast 0: the left and right spheres never touch each other; sameBreast 0: the 25 spheres of ONE breast never touch
#   each other (neighbours sit side by side on her skin)
param breastVsBreast 0
param sameBreast 0
# coneMode 1: each joint's swing limit = the XML's angular limit PLUS its +-0.5 u slide seen as swing at that link's length
#   (0 = the angular limit alone - a strand of 3 then bends only +-0.1 rad per link: stiff under a hand)
param coneMode 1
param xmlAngLimit 0.1000
param xmlSlideU 0.5000
param xmlStarAng 0.2000
# shellRadius: the sphere radius (u, unscaled) - each sphere is also at most half the distance to its nearest neighbour
param shellRadius 0.5
# the RIGHT nipple's UV = PPB's R_nipple landmark (CapFix.cpp kUvLandmarks; PPB_tuning.txt lmNipU/lmNipV). Left = (1-u, v).
nipuv 0.424242 0.698242
exclude NPC Spine1 [Spn1]|user rule: body node the breast attaches to
exclude NPC Spine2 [Spn2]|user rule: body node the breast attaches to (PPB C11/C12 breast capsules are its children)
# FSMP hand-over (as v1): the wearer's breast lattice switched to the kinematic XML while HavokWig drives it
fsmp meshes\actors\character\character assets\softbodyFix.xml|SKSE\Plugins\PPB\HavokBreast\softbodyFix_kinematic.xml
fsmp meshes\actors\character\character assets\softbody_preset1.xml|SKSE\Plugins\PPB\HavokBreast\softbodyFix_kinematic.xml
fsmp meshes\actors\character\character assets\softbody_preset2.xml|SKSE\Plugins\PPB\HavokBreast\softbodyFix_kinematic.xml
fsmp meshes\actors\character\character assets\softbody_preset3.xml|SKSE\Plugins\PPB\HavokBreast\softbodyFix_kinematic.xml
fsmp meshes\actors\character\character assets\softbody_preset4.xml|SKSE\Plugins\PPB\HavokBreast\softbodyFix_kinematic.xml
fsmp meshes\actors\character\character assets\softbody_preset5.xml|SKSE\Plugins\PPB\HavokBreast\softbodyFix_kinematic.xml
fsmp meshes\actors\character\character assets\softbody_preset6.xml|SKSE\Plugins\PPB\HavokBreast\softbodyFix_kinematic.xml
